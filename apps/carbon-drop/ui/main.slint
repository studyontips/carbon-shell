import { HorizontalBox } from "std-widgets.slint";

export enum AppState {
    Idle,
    Uploading,
    Success,
}

export component MainWindow inherits Window {
    title: "Carbon Drop";
    width: 640px;
    height: 520px;
    background: transparent;

    in-out property <AppState> state: AppState.Idle;
    in-out property <int> app_state: 0;
    in-out property <bool> dropdown_open: false;
    in-out property <string> active_api: "Gofile.io";
    in-out property <string> active_capacity: "10GB+";
    in-out property <float> upload_progress: 0.0;
    in-out property <string> file_name: "";
    in-out property <string> result_url: "";
    in-out property <string> final_url: "";
    in-out property <string> status_message: "";
    in-out property <string> arc_path: "M 40 8 A 32 32 0 0 1 72 40";
    in-out property <bool> is_drag_over: false;
    in-out property <bool> is_paused: false;
    in-out property <bool> link_copied: false;

    callback select_api(string);
    callback browse_clicked();
    callback open_file_dialog();
    callback start_upload(string);
    callback copy_to_clipboard(string);
    callback cancel_upload();
    callback pause_toggle();
    callback copy_link();
    callback reset_state();
    callback close_window();
    callback paste_from_clipboard();

    forward-focus: focus_scope;
    focus_scope := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                root.paste_from_clipboard();
                return accept;
            }
            return reject;
        }

        // Main dark frosted glass container
        main_card := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 16px;
        background: #0a0b0e;
        border-width: 1px;
        border-color: #ffffff1a;
        clip: true;

        // Top Tactical Drag / Title Area
        WindowMoveArea {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 32px;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "CARBON // DROP";
                        color: #ffffff77;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }
                }

                // Window Close button
                close_btn := Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: close_touch.has-hover ? #ff555533 : transparent;

                    close_touch := TouchArea {
                        clicked => {
                            root.close_window();
                        }
                    }

                    Text {
                        text: "✕";
                        color: close_touch.has-hover ? #ff5555 : #ffffff44;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ==========================================
        // TOP 70%: THE TACTICAL DROP ZONE (592x312)
        // ==========================================
        drop_zone := Rectangle {
            x: 24px;
            y: 32px;
            width: 592px;
            height: 312px;
            border-radius: 12px;
            clip: true;

            // Background faint dots pattern
            Image {
                width: 100%;
                height: 100%;
                source: @image-url("assets/dots.svg");
            }

            // Tactical Dashed border
            Image {
                width: 100%;
                height: 100%;
                source: (root.is_drag_over || drop_touch.has-hover)
                    ? @image-url("assets/dashed_border_active.svg")
                    : @image-url("assets/dashed_border.svg");
            }

            // Clickable drop zone triggers file dialog when clicked in Idle state
            drop_touch := TouchArea {
                enabled: root.state == AppState.Idle;
                clicked => {
                    root.open_file_dialog();
                }
            }

            // STATE OVERLAYS
            // 1. Idle Overlay
            if root.state == AppState.Idle : VerticalLayout {
                alignment: center;
                spacing: 10px;

                Text {
                    text: "◇";
                    color: (root.is_drag_over || drop_touch.has-hover) ? #00f0ff : #ffffff66;
                    font-size: 32px;
                    horizontal-alignment: center;
                    animate color { duration: 150ms; }
                }

                Text {
                    text: "DRAG & DROP FILE";
                    color: (root.is_drag_over || drop_touch.has-hover) ? #ffffff : #ffffff99;
                    font-size: 15px;
                    font-weight: 700;
                    letter-spacing: 2px;
                    horizontal-alignment: center;
                    animate color { duration: 150ms; }
                }

                Text {
                    text: "release file in the zone to upload";
                    color: #ffffff44;
                    font-size: 12px;
                    horizontal-alignment: center;
                }

                if root.status_message != "" : Text {
                    text: root.status_message;
                    color: #f38ba8;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }

            // 2. Uploading Overlay
            if root.state == AppState.Uploading : VerticalLayout {
                alignment: center;
                spacing: 12px;

                // Circular Progress Ring
                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: 80px;
                        height: 80px;

                        // Ring background track
                        Path {
                            width: 80px;
                            height: 80px;
                            commands: "M 40 8 A 32 32 0 1 1 39.99 8";
                            stroke: #ffffff18;
                            stroke-width: 5px;
                        }

                        // Ring active cyan arc
                        Path {
                            width: 80px;
                            height: 80px;
                            commands: root.arc_path;
                            stroke: #00f0ff;
                            stroke-width: 5px;
                        }

                        // Percentage inside ring
                        Text {
                            text: (Math.round(root.upload_progress * 100)) + "%";
                            color: #00f0ff;
                            font-size: 15px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: "Uploading to " + root.active_api + "... " + (Math.round(root.upload_progress * 100)) + "%";
                    color: #ffffffcc;
                    font-size: 14px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    horizontal-alignment: center;
                }

                if root.file_name != "" : Text {
                    text: root.file_name;
                    color: #ffffff66;
                    font-size: 12px;
                    horizontal-alignment: center;
                    overflow: elide;
                    max-width: 450px;
                }
            }

            // 3. Success Overlay
            if root.state == AppState.Success : VerticalLayout {
                alignment: center;
                spacing: 12px;

                HorizontalLayout {
                    alignment: center;

                    Image {
                        width: 52px;
                        height: 52px;
                        source: @image-url("assets/check.svg");
                    }
                }

                Text {
                    text: "Upload Complete";
                    color: #22c55e;
                    font-size: 18px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    horizontal-alignment: center;
                }

                if root.file_name != "" : Text {
                    text: root.file_name;
                    color: #ffffff77;
                    font-size: 12px;
                    horizontal-alignment: center;
                    overflow: elide;
                    max-width: 450px;
                }
            }
        }

        // ==========================================
        // 1px Horizontal Hairline Divider
        // ==========================================
        Rectangle {
            x: 24px;
            y: 360px;
            width: 592px;
            height: 1px;
            background: #ffffff16;
        }

        // ==========================================
        // BOTTOM 30%: THE CONTROL DECK
        // ==========================================
        control_deck := Rectangle {
            x: 24px;
            y: 374px;
            width: 592px;
            height: 122px;

            VerticalLayout {
                width: 100%;
                height: 100%;
                alignment: space-between;

                // TOP ROW: Compact API Dropdown Selector
                HorizontalLayout {
                    alignment: center;
                    dropdown_box := Rectangle {
                        width: 210px;
                        height: 34px;
                        border-radius: 8px;
                        background: dropdown_touch.has-hover ? #181b24 : #12141a;
                        border-width: 1px;
                        border-color: root.dropdown_open ? #00f0ff88 : (dropdown_touch.has-hover ? #ffffff25 : #ffffff1f);

                        dropdown_touch := TouchArea {
                            clicked => { root.dropdown_open = !root.dropdown_open; }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            Text {
                                text: "◆ " + root.active_api + " (" + root.active_capacity + ")";
                                color: #00f0ff;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.dropdown_open ? "▲" : "▾";
                                color: #ffffff88;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

            // BOTTOM ROW: Contextual Actions
            HorizontalLayout {
                width: 100%;
                height: 48px;
                alignment: space-between;

                // === STATE: IDLE ===
                if root.state == AppState.Idle : HorizontalLayout {
                    width: 100%;
                    alignment: space-between;

                    Text {
                        text: "Max file size: " + root.active_capacity;
                        color: #ffffff55;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: end;

                        // Flush Paste File button
                        TouchArea {
                            width: 130px;
                            clicked => {
                                root.paste_from_clipboard();
                            }
                            Text {
                                text: "[ 📋 PASTE FILE ]";
                                color: parent.pressed ? #ffffff : #8ee8a8;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        // Flush manual browse button
                        TouchArea {
                            width: 110px;
                            clicked => {
                                root.open_file_dialog();
                            }
                            Text {
                                text: "[ ⇪ BROWSE ]";
                                color: parent.pressed ? #ffffff : #8ee8a8;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                // === STATE: UPLOADING ===
                if root.state == AppState.Uploading : HorizontalLayout {
                    width: 100%;
                    alignment: space-between;

                    // Left status / rate
                    Text {
                        text: root.is_paused ? "Upload Paused" : (root.status_message != "" ? root.status_message : "Transferring data...");
                        color: root.is_paused ? #e5c07b : #ffffff77;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;

                        // [ || PAUSE ]
                        pause_btn := Rectangle {
                            width: 100px;
                            height: 36px;
                            border-radius: 8px;
                            background: pause_touch.has-hover ? #ffffff18 : #ffffff0a;
                            border-width: 1px;
                            border-color: #ffffff20;

                            pause_touch := TouchArea {
                                clicked => {
                                    root.pause_toggle();
                                }
                            }

                            Text {
                                text: root.is_paused ? "▶ RESUME" : "|| PAUSE";
                                color: root.is_paused ? #e5c07b : #ffffffcc;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // [ ✕ CANCEL ] - Glows red on hover
                        cancel_btn := Rectangle {
                            width: 104px;
                            height: 36px;
                            border-radius: 8px;
                            background: cancel_touch.has-hover ? #f38ba833 : #ffffff0a;
                            border-width: 1px;
                            border-color: cancel_touch.has-hover ? #f38ba8 : #ffffff20;
                            animate background { duration: 120ms; }
                            animate border-color { duration: 120ms; }

                            cancel_touch := TouchArea {
                                clicked => {
                                    root.cancel_upload();
                                }
                            }

                            Text {
                                text: "✕ CANCEL";
                                color: cancel_touch.has-hover ? #f38ba8 : #ffffffcc;
                                font-size: 12px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                animate color { duration: 120ms; }
                            }
                        }
                    }
                }

                // === STATE: SUCCESS ===
                if root.state == AppState.Success : HorizontalBox {
                    alignment: space-between;
                    width: 100%;
                    padding-left: 16px;
                    padding-right: 16px;
                    
                    // The scrollable, selectable (but read-only) URL box
                    TextInput {
                        text: root.final_url;
                        read-only: true;
                        color: #8ee8a8; // Theme.primary
                        font-size: 13px;
                        width: 320px;
                        single-line: true;
                    }
                    
                    // The Copy Button
                    TouchArea {
                        width: 100px;
                        clicked => { root.copy_to_clipboard(root.final_url); }
                        Text { 
                            text: "[ ⧉ COPY ]"; 
                            color: parent.pressed ? #ffffff : #8ee8a8;
                        }
                    }

                    // Reset / New Upload Button
                    TouchArea {
                        width: 80px;
                        clicked => { root.reset_state(); }
                        Text {
                            text: "[ + NEW ]";
                            color: parent.pressed ? #ffffff : #ffffff88;
                        }
                    }
                }
            }
        }
    }

    // Dropdown dismiss backdrop
        TouchArea {
            visible: root.dropdown_open;
            enabled: root.dropdown_open;
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            clicked => {
                root.dropdown_open = false;
            }
        }

        // Floating Dropdown Menu Card (floats above control deck)
        Rectangle {
            visible: root.dropdown_open;
            x: 215px;
            y: 192px;
            width: 210px;
            height: 178px;
            border-radius: 8px;
            background: #14171f;
            border-width: 1px;
            border-color: #00f0ff44;
            clip: true;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                // Option 1: Gofile.io
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: opt_gofile_touch.has-hover ? #00f0ff1a : (root.active_api == "Gofile.io" ? #00f0ff10 : transparent);
                    opt_gofile_touch := TouchArea {
                        clicked => {
                            root.active_api = "Gofile.io";
                            root.active_capacity = "10GB+";
                            root.select_api("Gofile.io");
                            root.dropdown_open = false;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;
                        Text {
                            text: (root.active_api == "Gofile.io" ? "◆ " : "  ") + "Gofile.io";
                            color: root.active_api == "Gofile.io" ? #00f0ff : (opt_gofile_touch.has-hover ? #ffffff : #ffffffcc);
                            font-size: 12px;
                            font-weight: root.active_api == "Gofile.io" ? 600 : 400;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "10GB+";
                            color: root.active_api == "Gofile.io" ? #00f0ffaa : #ffffff66;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Option 2: Buzzheavier
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: opt_buzz_touch.has-hover ? #00f0ff1a : (root.active_api == "Buzzheavier" ? #00f0ff10 : transparent);
                    opt_buzz_touch := TouchArea {
                        clicked => {
                            root.active_api = "Buzzheavier";
                            root.active_capacity = "10GB+";
                            root.select_api("Buzzheavier");
                            root.dropdown_open = false;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;
                        Text {
                            text: (root.active_api == "Buzzheavier" ? "◆ " : "  ") + "Buzzheavier";
                            color: root.active_api == "Buzzheavier" ? #00f0ff : (opt_buzz_touch.has-hover ? #ffffff : #ffffffcc);
                            font-size: 12px;
                            font-weight: root.active_api == "Buzzheavier" ? 600 : 400;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "10GB+";
                            color: root.active_api == "Buzzheavier" ? #00f0ffaa : #ffffff66;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Option 3: Bashupload
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: opt_bash_touch.has-hover ? #00f0ff1a : (root.active_api == "Bashupload" ? #00f0ff10 : transparent);
                    opt_bash_touch := TouchArea {
                        clicked => {
                            root.active_api = "Bashupload";
                            root.active_capacity = "25GB";
                            root.select_api("Bashupload");
                            root.dropdown_open = false;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;
                        Text {
                            text: (root.active_api == "Bashupload" ? "◆ " : "  ") + "Bashupload";
                            color: root.active_api == "Bashupload" ? #00f0ff : (opt_bash_touch.has-hover ? #ffffff : #ffffffcc);
                            font-size: 12px;
                            font-weight: root.active_api == "Bashupload" ? 600 : 400;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "25GB";
                            color: root.active_api == "Bashupload" ? #00f0ffaa : #ffffff66;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Option 4: x0.at
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: opt_x0_touch.has-hover ? #00f0ff1a : (root.active_api == "x0.at" ? #00f0ff10 : transparent);
                    opt_x0_touch := TouchArea {
                        clicked => {
                            root.active_api = "x0.at";
                            root.active_capacity = "1GB";
                            root.select_api("x0.at");
                            root.dropdown_open = false;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;
                        Text {
                            text: (root.active_api == "x0.at" ? "◆ " : "  ") + "x0.at";
                            color: root.active_api == "x0.at" ? #00f0ff : (opt_x0_touch.has-hover ? #ffffff : #ffffffcc);
                            font-size: 12px;
                            font-weight: root.active_api == "x0.at" ? 600 : 400;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "1GB";
                            color: root.active_api == "x0.at" ? #00f0ffaa : #ffffff66;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }

                // Option 5: kappa.lol
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: opt_kappa_touch.has-hover ? #00f0ff1a : (root.active_api == "kappa.lol" ? #00f0ff10 : transparent);
                    opt_kappa_touch := TouchArea {
                        clicked => {
                            root.active_api = "kappa.lol";
                            root.active_capacity = "100MB";
                            root.select_api("kappa.lol");
                            root.dropdown_open = false;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;
                        Text {
                            text: (root.active_api == "kappa.lol" ? "◆ " : "  ") + "kappa.lol";
                            color: root.active_api == "kappa.lol" ? #00f0ff : (opt_kappa_touch.has-hover ? #ffffff : #ffffffcc);
                            font-size: 12px;
                            font-weight: root.active_api == "kappa.lol" ? 600 : 400;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "100MB";
                            color: root.active_api == "kappa.lol" ? #00f0ffaa : #ffffff66;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
}
